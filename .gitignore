# Nunca versionar credenciais
.env
*.key
secrets*

# Dados coletados. O repositório é privado: versionam-se as planilhas e os
# relatórios pequenos, para não depender de uma cópia só. APKs, listas grandes
# do AndroZoo e PDFs de artigos ficam sempre fora.
scripts/dados/
dados/*
!dados/revisao/
dados/revisao/pdf/
dados/revisao/*.bak.csv
!dados/n3_corpus_*.csv
!dados/n3_relatorio_*.json
!dados/controle_ampliado_*.json

# Python
__pycache__/
*.pyc
venv/
.venv/

# Sistema
.DS_Store
