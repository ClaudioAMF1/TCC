# Nunca versionar credenciais
.env
*.key
secrets*

# Dados coletados. Versionam-se só as planilhas e os relatórios necessários.
# Ficam sempre fora: APKs, listas do AndroZoo, PDFs de artigos e as fichas dos
# publicadores (n3_fichas_*.json), que trazem contatos e podem ser geradas de
# novo com scripts/fichas_publicadores.py.
scripts/dados/
dados/*
!dados/revisao/
dados/revisao/pdf/
dados/revisao/*.bak.csv
!dados/n3_corpus_*.csv
!dados/n3_relatorio_*.json
!dados/controle_ampliado_*.json

# Python
__pycache__/
*.pyc
venv/
.venv/

# Sistema
.DS_Store
